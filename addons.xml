<?xml version='1.0' encoding='utf-8'?>
<addons>
  <addon id="repository.vaquexflix" name="Vaquexflix Repo" version="1.0.0" provider-name="Fmono90">
    <extension point="xbmc.addon.repository" name="Vaquexflix Repo">
      <dir>
        <info compressed="false">https://fmono90.github.io/vaquexflix-addon/addons.xml</info>
        <checksum>https://fmono90.github.io/vaquexflix-addon/addons.xml.md5</checksum>
        <datadir zip="true">https://fmono90.github.io/vaquexflix-addon/</datadir>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="es">Repositorio Oficial Vaquexflix</summary>
      <description lang="es">Instalador y actualizaciones automaticas de Vaquexflix.</description>
      <platform>all</platform>
      <assets>
        <icon>icon.png</icon>
      </assets>
    </extension>
  </addon>
  <addon id="plugin.video.vaquexflix" name="Vaquexflix" version="1.0.3" provider-name="Fmono90">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.script" library="main.py">
      <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="es">Vaquexflix</summary>
      <description lang="es">Complemento nativo de streaming multimedia.</description>
      <platform>all</platform>
      <assets>
        <icon>icon.png</icon>
        <fanart>fanart.jpg</fanart>
      </assets>
    </extension>
  </addon>
</addons>